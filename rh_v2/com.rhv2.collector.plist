<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS 每小时第 3 分钟跑一次。
     安装：cp com.rhv2.collector.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.rhv2.collector.plist
     卸载：launchctl bootout gui/$(id -u)/com.rhv2.collector && rm ~/Library/LaunchAgents/com.rhv2.collector.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.rhv2.collector</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>/opt/homebrew/bin/python3</string><string>/Users/zhaomosheng/Desktop/ctiwvGy8hZk3VdCu-grok-workspace/rh_v2/run.py</string><string>once</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/zhaomosheng/Desktop/ctiwvGy8hZk3VdCu-grok-workspace/rh_v2</string>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>3</integer></dict>
  <key>StandardOutPath</key><string>/Users/zhaomosheng/Desktop/ctiwvGy8hZk3VdCu-grok-workspace/rh_v2/logs/collector.log</string>
  <key>StandardErrorPath</key><string>/Users/zhaomosheng/Desktop/ctiwvGy8hZk3VdCu-grok-workspace/rh_v2/logs/collector.log</string>
</dict></plist>
