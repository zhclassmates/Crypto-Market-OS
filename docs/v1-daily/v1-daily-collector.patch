@@ -0,0 +1,720 @@
+"""V1 每日原始数据采集：token universe → GMGN → 结构化日快照 + 原始 JSON。
+
+只做：采集、落库、存 raw、基础错误处理、基础去重、数据完整性校验。
+不做：评分、买点、强弱、阈值、预测、回测。表里只放 GMGN 返回的事实。
+
+不是独立采集器：
+- 网络调用全部经过 market_collect.gmgn()（guard_or_raise 拦共享冷却；429 / RATE_LIMIT_*
+  经 observe_error 武装 GLOBAL_GMGN_COOLDOWN），网络类错误复用 gmgn_with_net_retry。
+- 日常运行是 market_lanes 串行 GMGN 循环里的 gmgn_daily 车道（每条链 DAILY_PERIOD_SEC
+  一次，每次 DAILY_BATCH 个 token），与其它车道共用 1 req/s 节奏和冷却。
+- 日 K 写入复用 market_research.commit_kline_fetch → token_candle / daily_kline，
+  FINALIZED 合同不变：observed_at >= bar_end（当天 UTC 的 K 永远不会定稿）。
+- Trending / Trenches / Security 车道已经拉到的响应，每个 UTC 日首个有效响应顺带写
+  raw + 快照行（record_list_payload / record_security_payload），不额外请求。
+
+source 不合并：token_daily_snapshot 一行 = 一个 endpoint 的一次观测，带 source 和 fetched_at。
+"""
+import hashlib
+import json
+import os
+import sqlite3
+import subprocess
+import time
+
+import market_db as db
+
+DAY_SEC = 86400
+COLLECTOR = "daily"
+HOOK_COLLECTOR = "daily_hook"
+
+# 车道节奏。每条链每 DAILY_PERIOD_SEC 秒处理 DAILY_BATCH 个 token。
+# 默认 60s × 1 × 4 链 ≈ 5,760 token/天，每个 token 1–2 次 GMGN 请求。稳定优先于频率。
+DAILY_PERIOD_SEC = int(os.environ.get("MARKET_DAILY_PERIOD_SEC", "60"))
+DAILY_BATCH = max(1, int(os.environ.get("MARKET_DAILY_BATCH", "1")))
+# research = token_registry 里已有 50k 流动性观察的研究币（永久账本，掉榜不删）+ 种子币
+# registry = token_registry 全部
+DAILY_UNIVERSE = os.environ.get("MARKET_DAILY_UNIVERSE", "research")
+# 同一 UTC 日、同一 token，token_info 非限流失败超过这个次数就不再重试，留到明天。
+MAX_ATTEMPTS_PER_DAY = int(os.environ.get("MARKET_DAILY_MAX_ATTEMPTS", "3"))
+# 同一批内相邻两次 GMGN 请求的最小间隔，与 market_lanes.GMGN_GAP 一致。
+REQUEST_GAP_SEC = 1.05
+
+SOURCE_TOKEN_INFO = "token_info"
+SOURCE_TRENDING = "trending"
+SOURCE_TRENCHES = "trenches"
+SOURCE_SECURITY = "security"
+
+ENDPOINT_TOKEN_INFO = "token_info"
+ENDPOINT_KLINE = "market_kline"
+ENDPOINT_TRENDING = "market_trending"
+ENDPOINT_TRENCHES = "market_trenches"
+ENDPOINT_SECURITY = "token_security"
+
+LIST_ENDPOINT = {SOURCE_TRENDING: ENDPOINT_TRENDING, SOURCE_TRENCHES: ENDPOINT_TRENCHES}
+
+# 字段审计结论：这些 (source, field) 在这些链上恒为 0，是 GMGN 不计算，不是真实 0 → NULL。
+# 非 0 值照存（如果以后 GMGN 开始计算）。
+ZERO_MEANS_UNSUPPORTED = {
+    (SOURCE_TOKEN_INFO, "fresh_wallet_rate"): {"base", "eth"},
+    (SOURCE_TRENCHES, "fresh_wallet_rate"): {"base", "eth"},
+    (SOURCE_TOKEN_INFO, "bundler_rate"): {"base", "eth"},
+    (SOURCE_TRENDING, "bundler_rate"): {"base", "eth"},
+    (SOURCE_TRENCHES, "dev_team_hold_rate"): {"base", "eth"},
+}
+# Trenches 未成交行的 price / market_cap / liquidity / holder_count = 0 表示没有数据。
+ZERO_MEANS_NO_DATA = {
+    SOURCE_TRENCHES: ("price", "market_cap", "liquidity", "holder_count"),
+}
+# 跟随 Trending --interval 的字段。只有 interval == 24h 才能写进 *_24h 列。
+TRENDING_WINDOW_FIELDS = ("volume_24h", "buys_24h", "sells_24h", "swaps_24h")
+
+SNAPSHOT_COLUMNS = (
+    "symbol", "price", "market_cap", "liquidity", "total_supply",
+    "volume_24h", "buys_24h", "sells_24h", "swaps_24h", "buy_volume_24h", "sell_volume_24h",
+    "holder_count", "ath_price", "fresh_wallet_rate", "top_10_holder_rate", "dev_team_hold_rate",
+    "smart_degen_count", "renowned_count", "sniper_count", "bundler_rate",
+    "whale_wallet_count", "bot_degen_count", "creator_token_status",
+    "launchpad_status", "launch_stage", "launch_progress", "migrated_at", "token_created_at",
+    "volume_1h", "volume_6h", "buy_volume_1h", "buy_volume_6h", "sell_volume_1h", "sell_volume_6h",
+    "buys_1h", "buys_6h", "sells_1h", "sells_6h", "swaps_1h", "swaps_6h",
+)
+
+_MISSING = object()
+
+
+class ValidationError(ValueError):
+    """响应结构不符合预期。不写快照，记 collection_errors。"""
+
+
+# ---------------------------------------------------------------- 解析工具
+
+def utc_day_start(ts):
+    ts = int(ts)
+    return ts - ts % DAY_SEC
+
+
+def addr_key(address):
+    text = "" if address is None else str(address).strip()
+    return text.lower() if text.lower().startswith("0x") else text
+
+
+def _get(obj, *path):
+    cur = obj
+    for key in path:
+        if not isinstance(cur, dict) or key not in cur:
+            return _MISSING
+        cur = cur[key]
+    return cur
+
+
+def _real(v):
+    if v is _MISSING or v is None or isinstance(v, bool):
+        return None
+    if isinstance(v, str):
+        v = v.strip()
+        if not v:
+            return None
+    try:
+        n = float(v)
+    except (TypeError, ValueError):
+        return None
+    if n != n or n in (float("inf"), float("-inf")):
+        return None
+    return n
+
+
+def _int(v):
+    n = _real(v)
+    if n is None:
+        return None
+    return int(n)
+
+
+def _text(v):
+    if v is _MISSING or v is None:
+        return None
+    text = str(v)
+    return text if text != "" else None
+
+
+def _ts(v):
+    """Unix 秒。0 / 负数 / 空 = 未知 → NULL。"""
+    if v is _MISSING:
+        return None
+    return db.unix_ts(v)
+
+
+def _apply_null_rules(source, chain, row):
+    for (src, field), chains in ZERO_MEANS_UNSUPPORTED.items():
+        if src == source and chain in chains and row.get(field) == 0:
+            row[field] = None
+    for field in ZERO_MEANS_NO_DATA.get(source, ()):
+        if row.get(field) == 0:
+            row[field] = None
+    return row
+
+
+def parse_token_info(chain, data):
+    """token info → 快照字段。market_cap 不存在于 token info，恒为 NULL，不推导。"""
+    price = _get(data, "price")
+    row = {
+        "symbol": _text(_get(data, "symbol")),
+        "price": _real(_get(price, "price")),
+        "market_cap": None,
+        "liquidity": _real(_get(data, "liquidity")),
+        "total_supply": _real(_get(data, "total_supply")),
+        "volume_24h": _real(_get(price, "volume_24h")),
+        "buys_24h": _int(_get(price, "buys_24h")),
+        "sells_24h": _int(_get(price, "sells_24h")),
+        "swaps_24h": _int(_get(price, "swaps_24h")),
+        "buy_volume_24h": _real(_get(price, "buy_volume_24h")),
+        "sell_volume_24h": _real(_get(price, "sell_volume_24h")),
+        "holder_count": _int(_get(data, "holder_count")),
+        "ath_price": _real(_get(data, "ath_price")),
+        "fresh_wallet_rate": _real(_get(data, "stat", "fresh_wallet_rate")),
+        "top_10_holder_rate": _real(_get(data, "stat", "top_10_holder_rate")),
+        "dev_team_hold_rate": _real(_get(data, "stat", "dev_team_hold_rate")),
+        "smart_degen_count": _int(_get(data, "wallet_tags_stat", "smart_wallets")),
+        "renowned_count": _int(_get(data, "wallet_tags_stat", "renowned_wallets")),
+        "sniper_count": _int(_get(data, "wallet_tags_stat", "sniper_wallets")),
+        "bundler_rate": _real(_get(data, "stat", "top_bundler_trader_percentage")),
+        "whale_wallet_count": _int(_get(data, "wallet_tags_stat", "whale_wallets")),
+        "bot_degen_count": _int(_get(data, "stat", "bot_degen_count")),
+        "creator_token_status": _text(_get(data, "dev", "creator_token_status")),
+        "launchpad_status": _int(_get(data, "launchpad_status")),
+        "launch_stage": None,
+        "launch_progress": _real(_get(data, "launchpad_progress")),
+        "migrated_at": _ts(_get(data, "migrated_timestamp")),
+        "token_created_at": _ts(_get(data, "creation_timestamp")),
+    }
+    if row["holder_count"] is None:
+        row["holder_count"] = _int(_get(data, "stat", "holder_count"))
+    for window in ("1h", "6h"):
+        row[f"volume_{window}"] = _real(_get(price, f"volume_{window}"))
+        row[f"buy_volume_{window}"] = _real(_get(price, f"buy_volume_{window}"))
+        row[f"sell_volume_{window}"] = _real(_get(price, f"sell_volume_{window}"))
+        row[f"buys_{window}"] = _int(_get(price, f"buys_{window}"))
+        row[f"sells_{window}"] = _int(_get(price, f"sells_{window}"))
+        row[f"swaps_{window}"] = _int(_get(price, f"swaps_{window}"))
+    return _apply_null_rules(SOURCE_TOKEN_INFO, chain, row)
+
+
+def parse_trending_row(chain, item, interval):
+    """Trending 行。creation_timestamp 是开盘/迁移时间，不当作代币创建时间。"""
+    mcap = _get(item, "market_cap")
+    if mcap is _MISSING or mcap is None:
+        mcap = _get(item, "usd_market_cap")
+    row = {
+        "symbol": _text(_get(item, "symbol")),
+        "price": _real(_get(item, "price")),
+        "market_cap": _real(mcap),
+        "liquidity": _real(_get(item, "liquidity")),
+        "total_supply": _real(_get(item, "total_supply")),
+        "volume_24h": _real(_get(item, "volume")),
+        "buys_24h": _int(_get(item, "buys")),
+        "sells_24h": _int(_get(item, "sells")),
+        "swaps_24h": _int(_get(item, "swaps")),
+        "holder_count": _int(_get(item, "holder_count")),
+        "top_10_holder_rate": _real(_get(item, "top_10_holder_rate")),
+        "dev_team_hold_rate": _real(_get(item, "dev_team_hold_rate")),
+        "smart_degen_count": _int(_get(item, "smart_degen_count")),
+        "renowned_count": _int(_get(item, "renowned_count")),
+        "sniper_count": _int(_get(item, "sniper_count")),
+        "bundler_rate": _real(_get(item, "bundler_rate")),
+        "bot_degen_count": _int(_get(item, "bot_degen_count")),
+        "creator_token_status": _text(_get(item, "creator_token_status")),
+        "launchpad_status": _int(_get(item, "launchpad_status")),
+    }
+    if interval != "24h":
+        for field in TRENDING_WINDOW_FIELDS:
+            row[field] = None
+    return _apply_null_rules(SOURCE_TRENDING, chain, row)
+
+
+def parse_trenches_row(chain, bucket, item):
+    """Trenches 行。buy/sell_volume_24h、net_buy_24h、new_wallet_volume 不可靠，不进列（raw 里有）。"""
+    mcap = _get(item, "market_cap")
+    if mcap is _MISSING or mcap is None:
+        mcap = _get(item, "usd_market_cap")
+    row = {
+        "symbol": _text(_get(item, "symbol")),
+        "price": _real(_get(item, "price")),
+        "market_cap": _real(mcap),
+        "liquidity": _real(_get(item, "liquidity")),
+        "total_supply": _real(_get(item, "total_supply")),
+        "volume_24h": _real(_get(item, "volume_24h")),
+        "buys_24h": _int(_get(item, "buys_24h")),
+        "sells_24h": _int(_get(item, "sells_24h")),
+        "swaps_24h": _int(_get(item, "swaps_24h")),
+        "holder_count": _int(_get(item, "holder_count")),
+        "fresh_wallet_rate": _real(_get(item, "fresh_wallet_rate")),
+        "top_10_holder_rate": _real(_get(item, "top_10_holder_rate")),
+        "dev_team_hold_rate": _real(_get(item, "dev_team_hold_rate")),
+        "smart_degen_count": _int(_get(item, "smart_degen_count")),
+        "renowned_count": _int(_get(item, "renowned_count")),
+        "sniper_count": _int(_get(item, "sniper_count")),
+        "bot_degen_count": _int(_get(item, "bot_degen_count")),
+        "creator_token_status": _text(_get(item, "creator_token_status")),
+        "launchpad_status": _int(_get(item, "launchpad_status")),
+        "launch_stage": bucket,
+        "launch_progress": _real(_get(item, "progress")),
+        "migrated_at": _ts(_get(item, "complete_timestamp")),
+        "token_created_at": _ts(_get(item, "created_timestamp")),
+    }
+    return _apply_null_rules(SOURCE_TRENCHES, chain, row)
+
+
+def parse_security(chain, data):
+    row = {"top_10_holder_rate": _real(_get(data, "top_10_holder_rate"))}
+    return _apply_null_rules(SOURCE_SECURITY, chain, row)
+
+
+# ---------------------------------------------------------------- 校验
+
+def validate_token_info(address, data):
+    if not isinstance(data, dict):
+        raise ValidationError("token info payload is not an object")
+    got = data.get("address")
+    if not got or addr_key(got) != addr_key(address):
+        raise ValidationError(f"token info address mismatch: asked {address} got {got}")
+    if not isinstance(data.get("price"), dict):
+        raise ValidationError("token info has no price object")
+    price = _real(data["price"].get("price"))
+    if price is None or price < 0:
+        raise ValidationError(f"token info price invalid: {data['price'].get('price')!r}")
+
+
+def validate_kline(data):
+    if not isinstance(data, dict) or not isinstance(data.get("list"), list):
+        raise ValidationError("kline payload has no list[]")
+
+
+def trending_rows(payload):
+    if not isinstance(payload, dict):
+        raise ValidationError("trending payload is not an object")
+    rows = (payload.get("data") or {}).get("rank") if isinstance(payload.get("data"), dict) else None
+    if not isinstance(rows, list):
+        raise ValidationError("trending payload has no data.rank[]")
+    return [(None, r) for r in rows if isinstance(r, dict) and r.get("address")]
+
+
+def trenches_rows(payload):
+    import market_research as R
+    if not isinstance(payload, dict):
+        raise ValidationError("trenches payload is not an object")
+    rows = R.parse_trench_items(payload)
+    data = payload.get("data") if isinstance(payload.get("data"), dict) else payload
+    if not rows and not any(isinstance(data.get(k), list) for k in ("new_creation", "near_completion", "pump", "completed")):
+        raise ValidationError("trenches payload has no bucket lists")
+    return rows
+
+
+def request_interval(args):
+    if not args:
+        return None
+    args = list(args)
+    for i, a in enumerate(args):
+        if a == "--interval" and i + 1 < len(args):
+            return str(args[i + 1])
+    return None
+
+
+# ---------------------------------------------------------------- 持久化
+
+def save_raw(con, chain, endpoint, token_address, args, payload, fetched_at):
+    """原样 JSON 入库（json.loads 后重新序列化，键序保持）。同一观测重复写入被唯一索引忽略。"""
+    text = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
+    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
+    args_json = None if args is None else json.dumps(list(args), ensure_ascii=False)
+    con.execute(
+        """INSERT OR IGNORE INTO raw_responses(
+             chain, token_address, endpoint, request_args, fetched_at, payload_sha256, payload_json)
+           VALUES(?,?,?,?,?,?,?)""",
+        (chain, token_address, endpoint, args_json, int(fetched_at), digest, text),
+    )
+    row = con.execute(
+        """SELECT id FROM raw_responses
+           WHERE chain=? AND endpoint=? AND IFNULL(token_address,'')=IFNULL(?, '')
+             AND fetched_at=? AND payload_sha256=?""",
+        (chain, endpoint, token_address, int(fetched_at), digest),
+    ).fetchone()
+    return row[0] if row else None
+
+
+def save_snapshot(con, chain, token_address, source, fetched_at, fields, raw_id=None, interval=None):
+    """同一 (chain, token, source, UTC 日) 只保留第一次观测；重复写入被忽略。返回 1 = 新写入。"""
+    cols = ["chain", "token_address", "source", "snapshot_day", "fetched_at", "request_interval", "raw_id"]
+    vals = [chain, token_address, source, utc_day_start(fetched_at), int(fetched_at), interval, raw_id]
+    for col in SNAPSHOT_COLUMNS:
+        if col in fields:
+            cols.append(col)
+            vals.append(fields[col])
+    cur = con.execute(
+        f"INSERT OR IGNORE INTO token_daily_snapshot({', '.join(cols)}) VALUES({', '.join('?' * len(cols))})",
+        vals,
+    )
+    return 1 if cur.rowcount else 0
+
+
+def raw_exists_today(con, chain, endpoint, token_address, now):
+    day = utc_day_start(now)
+    # 分开写 IS NULL / = ?，让 ix_raw_lookup(chain, endpoint, token_address, fetched_at) 整段可用。
+    addr_sql = "token_address IS NULL" if token_address is None else "token_address=?"
+    args = [chain, endpoint] + ([] if token_address is None else [token_address]) + [day, day + DAY_SEC]
+    row = con.execute(
+        f"""SELECT 1 FROM raw_responses
+            WHERE chain=? AND endpoint=? AND {addr_sql}
+              AND fetched_at>=? AND fetched_at<? LIMIT 1""",
+        args,
+    ).fetchone()
+    return row is not None
+
+
+def classify_error(exc):
+    import market_sched as sched
+    if isinstance(exc, sched.RateLimited):
+        return "cooldown" if str(exc).startswith("GLOBAL_GMGN_COOLDOWN") else "rate_limited"
+    if isinstance(exc, subprocess.TimeoutExpired):
+        return "timeout"
+    if isinstance(exc, ValidationError):
+        return "validation"
+    if isinstance(exc, json.JSONDecodeError):
+        return "parse_error"
+    if isinstance(exc, sqlite3.Error):
+        return "db_error"
+    if isinstance(exc, RuntimeError):
+        return "cli_error"
+    return "error"
+
+
+def record_error(con, chain, token_address, endpoint, exc, args, now, collector=COLLECTOR):
+    con.execute(
+        """INSERT INTO collection_errors(
+             collector, chain, token_address, endpoint, bucket_day, occurred_at,
+             error_kind, error_message, request_args)
+           VALUES(?,?,?,?,?,?,?,?,?)""",
+        (
+            collector, chain, token_address, endpoint, utc_day_start(now), int(now),
+            classify_error(exc), str(exc)[:1000],
+            None if args is None else json.dumps(list(args), ensure_ascii=False),
+        ),
+    )
+
+
+# ---------------------------------------------------------------- 顺带存档（不额外请求）
+
+def record_list_payload(con, chain, source, payload, args, now):
+    """Trending / Trenches 车道已拉到的响应：每链每 UTC 日第一个有效响应写 raw + 快照行。"""
+    endpoint = LIST_ENDPOINT[source]
+    if raw_exists_today(con, chain, endpoint, None, now):
+        return 0
+    interval = request_interval(args) if source == SOURCE_TRENDING else None
+    if source == SOURCE_TRENDING:
+        rows = trending_rows(payload)
+    else:
+        rows = trenches_rows(payload)
+    raw_id = save_raw(con, chain, endpoint, None, args, payload, now)
+    written = 0
+    for bucket, item in rows:
+        if source == SOURCE_TRENDING:
+            fields = parse_trending_row(chain, item, interval)
+        else:
+            fields = parse_trenches_row(chain, bucket, item)
+        written += save_snapshot(con, chain, item["address"], source, now, fields, raw_id, interval)
+    return written
+
+
+def record_security_payload(con, chain, address, payload, args, now):
+    """Security 车道已拉到的响应：每个 token 每 UTC 日第一个有效响应写 raw + 快照行。"""
+    if not isinstance(payload, dict):
+        raise ValidationError("security payload is not an object")
+    if raw_exists_today(con, chain, ENDPOINT_SECURITY, address, now):
+        return 0
+    raw_id = save_raw(con, chain, ENDPOINT_SECURITY, address, args, payload, now)
+    return save_snapshot(con, chain, address, SOURCE_SECURITY, now, parse_security(chain, payload), raw_id)
+
+
+def safe_hook(with_db, chain, address, endpoint, args, fn, now):
+    """车道顺带存档的保护壳：失败只记 collection_errors，不影响原车道。"""
+    try:
+        return with_db(fn)
+    except Exception as e:  # noqa: BLE001 — 存档失败绝不能拖垮发现车道
+        print(f"  daily hook {endpoint}:{chain} 失败: {str(e)[:120]}", flush=True)
+        try:
+            with_db(lambda con, exc=e: record_error(con, chain, address, endpoint, exc, args, now, HOOK_COLLECTOR))
+        except Exception:
+            pass
+        return 0
+
+
+# ---------------------------------------------------------------- 每日 token 采集
+
+def token_info_args(chain, address):
+    return ["token", "info", "--chain", chain, "--address", address]
+
+
+def pick_pending(con, chain, now, limit, mode=None):
+    """今天还没有 token_info 快照、且今日失败未达上限的 universe token。
+
+    排序：今日失败少的优先 → 最近没试过的优先 → 研究币按首次 50k 时间 → 地址。
+    限流 / 冷却不算失败次数。
+    """
+    mode = mode or DAILY_UNIVERSE
+    day = utc_day_start(now)
+    if mode == "registry":
+        where = "r.chain=?"
+    else:
+        where = "r.chain=? AND (r.first_liquidity_50k_at IS NOT NULL OR r.sources_seen LIKE '%\"seed\"%')"
+    rows = con.execute(
+        f"""SELECT r.address AS address
+            FROM token_registry r
+            LEFT JOIN token_daily_snapshot s
+              ON s.chain=r.chain AND s.token_address=r.address
+             AND s.source=? AND s.snapshot_day=?
+            LEFT JOIN (
+              SELECT token_address, COUNT(*) AS n, MAX(occurred_at) AS last
+              FROM collection_errors
+              WHERE collector=? AND chain=? AND bucket_day=? AND endpoint=?
+                AND error_kind NOT IN ('rate_limited', 'cooldown')
+              GROUP BY token_address
+            ) e ON e.token_address=r.address
+            WHERE {where} AND s.id IS NULL AND COALESCE(e.n, 0) < ?
+            ORDER BY COALESCE(e.n, 0), COALESCE(e.last, 0),
+                     r.first_liquidity_50k_at IS NULL, r.first_liquidity_50k_at, r.address
+            LIMIT ?""",
+        (SOURCE_TOKEN_INFO, day, COLLECTOR, chain, day, ENDPOINT_TOKEN_INFO, chain,
+         MAX_ATTEMPTS_PER_DAY, int(limit)),
+    ).fetchall()
+    return [r[0] for r in rows]
+
+
+def universe_size(con, chain, mode=None):
+    mode = mode or DAILY_UNIVERSE
+    if mode == "registry":
+        sql = "SELECT COUNT(*) FROM token_registry WHERE chain=?"
+    else:
+        sql = ("SELECT COUNT(*) FROM token_registry WHERE chain=? AND "
+               "(first_liquidity_50k_at IS NOT NULL OR sources_seen LIKE '%\"seed\"%')")
+    return con.execute(sql, (chain,)).fetchone()[0]
+
+
+def needs_kline(con, chain, address, now):
+    """昨日 UTC 日 K 已 FINALIZED（按现有合同）就不拉；今天已经为它拉过一次也不拉。"""
+    import market_research as R
+    yesterday = utc_day_start(now) - DAY_SEC
+    row = con.execute(
+        """SELECT candle_open_ts, fetched_at, finalized_at FROM token_candle
+           WHERE chain=? AND address=? AND candle_open_ts=? AND close IS NOT NULL""",
+        (chain, address, yesterday),
+    ).fetchone()
+    if row is not None and R.bar_status(
+        row["candle_open_ts"], row["fetched_at"], now, row["finalized_at"]
+    ) == R.STATUS_FINALIZED:
+        return False
+    return not raw_exists_today(con, chain, ENDPOINT_KLINE, address, now)
+
+
+def _default_gmgn():
+    import market_collect as M
+    return M.gmgn_with_net_retry
+
+
+def collect_batch(chain, addresses, with_db, gmgn_call=None, clock=time.time,
+                  sleep=time.sleep, gap=REQUEST_GAP_SEC, kline=True):
+    """一批 token：token info（必要时再拉日 K）。
+
+    单个 token 的任何失败只写 collection_errors，继续下一个。
+    限流（RateLimited）时共享冷却已由 gmgn() 武装：记录后立刻停止本批，剩余 token 留待冷却后。
+    """
+    import market_collect as M
+    import market_research as R
+    import market_sched as sched
+    gmgn_call = gmgn_call or _default_gmgn()
+    stats = {
+        "chain": chain, "requested": len(addresses), "token_info_ok": 0, "token_info_failed": 0,
+        "kline_ok": 0, "kline_skipped": 0, "kline_failed": 0, "candles_written": 0,
+        "raw_saved": 0, "rate_limited": False, "errors": [],
+    }
+    first_request = [True]
+
+    def call(args, timeout):
+        if not first_request[0] and gap:
+            sleep(gap)
+        first_request[0] = False
+        return gmgn_call(args, timeout=timeout)
+
+    def fail(address, endpoint, exc, args):
+        now = int(clock())
+        stats["errors"].append({"address": address, "endpoint": endpoint,
+                                "kind": classify_error(exc), "error": str(exc)[:200]})
+        try:
+            with_db(lambda con: record_error(con, chain, address, endpoint, exc, args, now))
+        except Exception as db_exc:  # noqa: BLE001
+            print(f"  collection_errors 写入失败: {db_exc}", flush=True)
+        return isinstance(exc, sched.RateLimited)
+
+    for address in addresses:
+        # 1) token info
+        args = token_info_args(chain, address)
+        try:
+            data = call(args, timeout=40)
+            fetched = int(clock())
+            validate_token_info(address, data)
+
+            def write_ti(con, data=data, fetched=fetched, args=args, address=address):
+                raw_id = save_raw(con, chain, ENDPOINT_TOKEN_INFO, address, args, data, fetched)
+                return save_snapshot(con, chain, address, SOURCE_TOKEN_INFO, fetched,
+                                     parse_token_info(chain, data), raw_id)
+
+            with_db(write_ti)
+            stats["token_info_ok"] += 1
+            stats["raw_saved"] += 1
+        except Exception as e:  # noqa: BLE001
+            stats["token_info_failed"] += 1
+            if fail(address, ENDPOINT_TOKEN_INFO, e, args):
+                stats["rate_limited"] = True
+                break
+
+        # 2) 日 K：只在昨日未定稿且今天还没为它拉过时请求
+        if not kline:
+            continue
+        try:
+            want = with_db(lambda con, a=address: needs_kline(con, chain, a, int(clock())))
+        except Exception as e:  # noqa: BLE001
+            fail(address, ENDPOINT_KLINE, e, None)
+            continue
+        if not want:
+            stats["kline_skipped"] += 1
+            continue
+        now = int(clock())
+        kargs = M.kline_args(chain, address, "1d", now - R.KLINE_FETCH_WINDOW_SEC, now)
+        try:
+            data = call(kargs, timeout=60)
+            fetched = int(clock())
+            validate_kline(data)
+
+            def write_k(con, data=data, fetched=fetched, kargs=kargs, address=address):
+                save_raw(con, chain, ENDPOINT_KLINE, address, kargs, data, fetched)
+                # 复用现有写入：token_candle + daily_kline，finalized 只在 fetched >= bar_end 时写。
+                return R.commit_kline_fetch(con, chain, address, data["list"], fetched, True)
+
+            written = with_db(write_k)
+            stats["kline_ok"] += 1
+            stats["raw_saved"] += 1
+            stats["candles_written"] += written or 0
+        except Exception as e:  # noqa: BLE001
+            stats["kline_failed"] += 1
+            if fail(address, ENDPOINT_KLINE, e, kargs):
+                stats["rate_limited"] = True
+                break
+    return stats
+
+
+# ---------------------------------------------------------------- CLI（冒烟 / 手动补跑）
+
+def _parse_cli(argv):
+    opts = {"chains": [], "limit": 3, "tokens": [], "no_kline": False}
+    it = iter(argv)
+    for a in it:
+        if a == "--chain":
+            opts["chains"].extend(x for x in next(it, "").split(",") if x)
+        elif a == "--limit":
+            opts["limit"] = int(next(it, "3"))
+        elif a == "--token":
+            spec = next(it, "")
+            if ":" not in spec:
+                raise SystemExit(f"--token 需要 chain:address，收到 {spec!r}")
+            c, addr = spec.split(":", 1)
+            opts["tokens"].append((c, addr))
+        elif a == "--no-kline":
+            opts["no_kline"] = True
+        else:
+            raise SystemExit(f"未知参数 {a}")
+    return opts
+
+
+def cli_run(argv):
+    """`market_run.py daily [--chain sol] [--limit 3] [--token chain:address ...] [--no-kline]`
+
+    走与常驻 loop 相同的 collector 文件锁：loop 在跑时直接退出，绝不并发打 GMGN。
+    """
+    import market_collect as M
+    import market_lanes as L
+    opts = _parse_cli(argv)
+    try:
+        lock_fd = M.acquire_lock()
+    except M.LockBusy:
+        return {
+            "skipped": True, "reason": "lock_busy",
+            "hint": "market collector loop 正在运行；gmgn_daily 车道已在 loop 内运行。"
+                    "要单独冒烟，先 launchctl bootout com.market.collector，跑完再 bootstrap。",
+        }
+    try:
+        out = []
+        if opts["tokens"]:
+            by_chain = {}
+            for c, addr in opts["tokens"]:
+                by_chain.setdefault(c, []).append(addr)
+            plan = list(by_chain.items())
+        else:
+            chains = opts["chains"] or list(M.CHAINS)
+            now = int(time.time())
+            plan = [(c, L.with_db(lambda con, c=c: pick_pending(con, c, now, opts["limit"]))) for c in chains]
+        for chain, addresses in plan:
+            if not addresses:
+                out.append({"chain": chain, "requested": 0, "note": "今日 universe 已全部采集或为空"})
+                continue
+            stats = collect_batch(chain, addresses, L.with_db, kline=not opts["no_kline"])
+            out.append(stats)
+            if stats["rate_limited"]:
+                break
+        return {"ok": True, "batches": out}
+    finally:
+        M.release_lock(lock_fd)
+
+
+def status(con, now=None):
+    now = int(time.time() if now is None else now)
+    day = utc_day_start(now)
+    chains = [r[0] for r in con.execute(
+        """SELECT chain FROM token_registry
+           UNION SELECT chain FROM token_daily_snapshot WHERE snapshot_day=?
+           ORDER BY 1""",
+        (day,),
+    )]
+    per_chain = []
+    for chain in chains:
+        counts = {
+            r["source"]: r["n"] for r in con.execute(
+                """SELECT source, COUNT(*) AS n FROM token_daily_snapshot
+                   WHERE chain=? AND snapshot_day=? GROUP BY source""",
+                (chain, day),
+            )
+        }
+        per_chain.append({
+            "chain": chain,
+            "universe": universe_size(con, chain),
+            "snapshots_today": counts,
+            "candles_finalized_yesterday": con.execute(
+                "SELECT COUNT(*) FROM token_candle WHERE chain=? AND candle_open_ts=? AND finalized_at IS NOT NULL",
+                (chain, day - DAY_SEC),
+            ).fetchone()[0],
+        })
+    errors = [dict(r) for r in con.execute(
+        """SELECT collector, chain, endpoint, error_kind, COUNT(*) AS n FROM collection_errors
+           WHERE bucket_day=? GROUP BY collector, chain, endpoint, error_kind ORDER BY n DESC""",
+        (day,),
+    )]
+    recent = [dict(r) for r in con.execute(
+        """SELECT occurred_at, collector, chain, token_address, endpoint, error_kind,
+                  substr(error_message, 1, 160) AS error_message
+           FROM collection_errors ORDER BY id DESC LIMIT 10"""
+    )]
+    raw = [dict(r) for r in con.execute(
+        """SELECT endpoint, COUNT(*) AS n, SUM(length(payload_json)) AS bytes FROM raw_responses
+           WHERE fetched_at>=? AND fetched_at<? GROUP BY endpoint""",
+        (day, day + DAY_SEC),
+    )]
+    return {"now": now, "utc_day": day, "universe_mode": DAILY_UNIVERSE, "chains": per_chain,
+            "raw_today": raw, "errors_today": errors, "recent_errors": recent}
