+        rows_parsed=stats["token_info_ok"], rows_written=wrote,
+        hot_changed=0, cold_changed=wrote,
+        source_timestamp_missing=True, wrote_db=bool(wrote),
+        run_state=state, request_ok=1 if wrote else 0, error=err,
