+class FakeCli:
+    """替代 subprocess.run 的 gmgn-cli。记录每条实际命令。"""
+
+    def __init__(self, fail=None):
+        self.calls = []
+        # fail: callable(cmd) -> None | (returncode, stderr)
+        self.fail = fail or (lambda cmd: None)
+
+    def __call__(self, cmd, capture_output=True, text=True, timeout=None):
+        self.calls.append(list(cmd))
+        failure = self.fail(cmd)
+        if failure:
+            code, err = failure
+            return types.SimpleNamespace(returncode=code, stdout="", stderr=err)
+        body = cmd[1:-1]  # 去掉 gmgn-cli 和 --raw
+        chain = _arg(body, "--chain")
+        if body[:2] == ["token", "info"]:
+            payload = fixture(TOKEN_INFO_FIXTURES[(chain, _arg(body, "--address"))])
+        elif body[:2] == ["market", "kline"]:
+            payload = kline_payload(int(_arg(body, "--to")))
+        elif body[:2] == ["market", "trending"]:
+            payload = fixture(f"v1/{chain}-trending.json")
+        elif body[:2] == ["market", "trenches"]:
+            payload = fixture(f"v1/{chain}-trenches.json")
+        elif body[:2] == ["token", "security"]:
+            payload = fixture(f"v1/{chain}-security.json")
+        else:
+            raise AssertionError(f"unexpected GMGN command {cmd}")
+        return types.SimpleNamespace(returncode=0, stdout=json.dumps(payload), stderr="")
+
