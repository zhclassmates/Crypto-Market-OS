+    def test_batch_persists_successes_and_survives_one_failure(self):
+        fake = FakeCli(fail=lambda cmd: (1, "Error: upstream 500 internal") if "eth" in cmd else None)
+        guard_calls = []
+        real_guard = sched.guard_or_raise
+        sleeps = []
+
+        def counting_guard(now=None):
+            guard_calls.append(now)
+            return real_guard(now)
+
+        with mock.patch.object(collect.subprocess, "run", fake), \
+                mock.patch.object(sched, "guard_or_raise", counting_guard):
+            stats = []
+            for chain, addr in (("sol", SOL_WWW), ("eth", ETH_WILD), ("base", BASE_TOSHI)):
+                stats.append(D.collect_batch(chain, [addr], lanes.with_db, clock=lambda: self.now,
+                                             sleep=sleeps.append))
+            # 同链多 token 一批：失败的 token 不中断后面的 token
+            fake2 = FakeCli(fail=lambda cmd: (1, "Error: bad token") if "BAD" in cmd else None)
+            with mock.patch.object(collect.subprocess, "run", fake2):
+                self.seed_research("sol", "BAD")
+                mixed = D.collect_batch("sol", ["BAD", SOL_WWW], lanes.with_db,
+                                        clock=lambda: self.now, sleep=sleeps.append)
+
+        # 守卫：每次实际 CLI 调用之前都经过 guard_or_raise
+        self.assertEqual(len(guard_calls), len(fake.calls) + len(fake2.calls))
+        self.assertGreater(len(sleeps), 0)  # 批内请求间隔
+        # 成功的 token 落库（sol / base），eth 失败
+        rows = self.q("""SELECT chain, token_address, source, fetched_at, market_cap, raw_id, price,
+                                buy_volume_24h, sell_volume_24h, volume_24h, symbol
+                         FROM token_daily_snapshot WHERE source='token_info' ORDER BY chain""")
+        self.assertEqual([(r["chain"], r["token_address"]) for r in rows], [("base", BASE_TOSHI), ("sol", SOL_WWW)])
+        for r in rows:
+            self.assertEqual(r["fetched_at"], self.now)
+            self.assertIsNone(r["market_cap"])
+            self.assertIsNotNone(r["raw_id"])
+            self.assertAlmostEqual(r["buy_volume_24h"] + r["sell_volume_24h"], r["volume_24h"], places=3)
+        # raw 原样可查
+        raw = self.q("SELECT endpoint, token_address, json_extract(payload_json,'$.address') AS a FROM raw_responses WHERE endpoint='token_info'")
+        self.assertEqual({(r["token_address"], r["a"]) for r in raw}, {(SOL_WWW, SOL_WWW), (BASE_TOSHI, BASE_TOSHI)})
+        # 错误落库，不抛
+        errs = self.q("SELECT chain, token_address, endpoint, error_kind, error_message FROM collection_errors ORDER BY id")
+        eth_errs = [e for e in errs if e["chain"] == "eth"]
+        self.assertEqual({e["endpoint"] for e in eth_errs}, {"token_info", "market_kline"})
+        self.assertTrue(all(e["error_kind"] == "cli_error" for e in eth_errs))
+        self.assertIn("upstream 500", eth_errs[0]["error_message"])
+        self.assertEqual(stats[1]["token_info_failed"], 1)
+        self.assertEqual(stats[2]["token_info_ok"], 1)
+        self.assertEqual(mixed["token_info_failed"], 1)
+        self.assertEqual(mixed["requested"], 2)
+        self.assertTrue(any(e["token_address"] == "BAD" for e in errs))
+
+        # 日 K：今天 UTC 的 K 不定稿；昨天的定稿（复用 observed_at >= bar_end 合同）
+        candles = {r["candle_open_ts"]: r for r in self.q(
+            "SELECT candle_open_ts, fetched_at, finalized_at, is_closed, volume, amount FROM token_candle WHERE chain='sol' AND address=?",
+            (SOL_WWW,))}
+        today_bar = candles[self.today]
+        y_bar = candles[self.today - DAY]
+        self.assertIsNone(today_bar["finalized_at"])
+        self.assertEqual(today_bar["is_closed"], 0)
+        self.assertEqual(R.bar_status(self.today, today_bar["fetched_at"], self.now, today_bar["finalized_at"]), R.STATUS_OPEN)
+        self.assertEqual(y_bar["finalized_at"], self.now)
+        self.assertEqual(y_bar["is_closed"], 1)
+        self.assertEqual(R.bar_status(self.today - DAY, y_bar["fetched_at"], self.now, y_bar["finalized_at"]), R.STATUS_FINALIZED)
+        self.assertIsNotNone(today_bar["amount"])
+        mirror = self.q("SELECT finalized_at FROM daily_kline WHERE chain='sol' AND address=? AND ts=?", (SOL_WWW, self.today))
+        self.assertIsNone(mirror[0][0])
+        self.assertEqual(self.q("SELECT COUNT(*) FROM raw_responses WHERE endpoint='market_kline' AND token_address=?", (SOL_WWW,))[0][0], 1)
+
+        # 同日重跑：不产生重复快照；昨日已定稿 → 不再拉日 K
+        with mock.patch.object(collect.subprocess, "run", FakeCli()) as again:
+            D.collect_batch("sol", [SOL_WWW], lanes.with_db, clock=lambda: self.now + 60, sleep=lambda s: None)
+        self.assertEqual(self.q("SELECT COUNT(*) FROM token_daily_snapshot WHERE chain='sol' AND source='token_info' AND token_address=?", (SOL_WWW,))[0][0], 1)
+        self.assertEqual([c[1:3] for c in again.calls], [["token", "info"]])
