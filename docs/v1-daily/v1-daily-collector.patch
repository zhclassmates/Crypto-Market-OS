+    def test_rate_limit_arms_shared_cooldown_and_stops_batch(self):
+        addrs = [SOL_WWW, "SOL2", "SOL3"]
+        for a in addrs[1:]:
+            self.seed_research("sol", a)
+
+        def fail(cmd):
+            if "SOL2" in cmd:
+                return (1, "HTTP 429 code=429 error=RATE_LIMIT_EXCEEDED Retry-After: 120")
+            return None
+
+        fake = FakeCli(fail=fail)
+        arm_calls = []
+        real_arm = sched.arm_cooldown
+
+        def spy_arm(now, decision, con=None):
+            arm_calls.append(decision)
+            return real_arm(now, decision, con=con)
+
+        before = int(time.time())
+        with mock.patch.object(collect.subprocess, "run", fake), \
+                mock.patch.object(sched, "arm_cooldown", spy_arm):
+            stats = D.collect_batch("sol", addrs, lanes.with_db, sleep=lambda s: None)
+        self.assertTrue(stats["rate_limited"])
+        self.assertEqual(len(arm_calls), 1)
+        self.assertEqual(arm_calls[0]["basis"], "retry_after")
+        # 共享冷却：进程内 + market_meta 持久化（其它进程/重启后可见）
+        self.assertGreaterEqual(sched.cooldown_until(), before + 120)
+        persisted = int(db.meta_get(self.con, "gmgn_cooldown_until"))
+        self.assertGreaterEqual(persisted, before + 120)
+        # 批次在限流处停止：SOL3 从未请求
+        self.assertFalse(any("SOL3" in c for c in fake.calls))
+        err = self.q("SELECT error_kind, token_address FROM collection_errors")
+        self.assertEqual([(e[0], e[1]) for e in err], [("rate_limited", "SOL2")])
+        # SOL_WWW 已经落库
+        self.assertEqual(self.q("SELECT COUNT(*) FROM token_daily_snapshot WHERE token_address=?", (SOL_WWW,))[0][0], 1)
+        # 限流不计入失败次数：SOL2 / SOL3 仍待采
+        pending = D.pick_pending(self.con, "sol", int(time.time()), 10)
+        self.assertEqual(set(pending), {"SOL2", "SOL3"})
+
+        # 冷却期内车道不发任何请求，source_health 记 cooldown
+        idle = FakeCli()
+        with mock.patch.object(collect.subprocess, "run", idle):
+            lanes.job_daily("sol")
+            with self.assertRaises(sched.RateLimited):
+                collect.gmgn(D.token_info_args("sol", "SOL2"))
+        self.assertEqual(idle.calls, [])
+        con = db.connect(self.path)
+        row = con.execute("SELECT run_state FROM source_health WHERE source='gmgn_daily' AND chain='sol'").fetchone()
+        con.close()
+        self.assertEqual(row[0], "cooldown")
+
