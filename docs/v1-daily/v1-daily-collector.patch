+def kline_payload(to_ts):
+    """录制形状：{list:[{time(ms), open, high, low, close, volume, amount, source:""}]}，最后一根是今天（进行中）。"""
+    today = int(to_ts) - int(to_ts) % DAY
+    out = []
+    for i, day in enumerate((today - 2 * DAY, today - DAY, today)):
+        px = 0.001 * (1 + i / 10)
+        out.append({
+            "time": day * 1000,
+            "open": f"{px:.10f}", "high": f"{px * 1.2:.10f}", "low": f"{px * 0.9:.10f}",
+            "close": f"{px * 1.1:.10f}", "volume": f"{1000 + i * 10:.8f}",
+            "amount": f"{(1000 + i * 10) / px:.6f}", "source": "",
+        })
+    return {"list": out}
+
+
+def _arg(cmd, name):
+    return cmd[cmd.index(name) + 1] if name in cmd else None
+
