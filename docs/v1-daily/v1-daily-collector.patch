+    price REAL,
+    market_cap REAL,                   -- token_info 没有此字段，恒为 NULL
+    liquidity REAL,
+    total_supply REAL,
+    volume_24h REAL,
+    buys_24h INTEGER,                  -- 笔数，不是人数
+    sells_24h INTEGER,
+    swaps_24h INTEGER,
+    buy_volume_24h REAL,               -- 只有 token_info 可靠，其它 source 为 NULL
+    sell_volume_24h REAL,
+    holder_count INTEGER,
+    ath_price REAL,
+    fresh_wallet_rate REAL,
+    top_10_holder_rate REAL,
+    dev_team_hold_rate REAL,
+    smart_degen_count INTEGER,
+    renowned_count INTEGER,
+    sniper_count INTEGER,
+    bundler_rate REAL,
+    whale_wallet_count INTEGER,
+    bot_degen_count INTEGER,
+    creator_token_status TEXT,
+    launchpad_status INTEGER,
+    launch_stage TEXT,                 -- trenches 分组：new_creation / near_completion / completed
+    launch_progress REAL,
+    migrated_at INTEGER,
+    token_created_at INTEGER,
+    volume_1h REAL, volume_6h REAL,
+    buy_volume_1h REAL, buy_volume_6h REAL,
+    sell_volume_1h REAL, sell_volume_6h REAL,
+    buys_1h INTEGER, buys_6h INTEGER,
+    sells_1h INTEGER, sells_6h INTEGER,
+    swaps_1h INTEGER, swaps_6h INTEGER,
+    UNIQUE (chain, token_address, source, snapshot_day)
+);
+CREATE INDEX IF NOT EXISTS ix_tds_day ON token_daily_snapshot(snapshot_day, chain, source);
+
+-- 每个有效 GMGN 响应的原样 JSON。列表 endpoint 的 token_address 为 NULL。
+CREATE TABLE IF NOT EXISTS raw_responses (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    chain TEXT NOT NULL,
+    token_address TEXT,
+    endpoint TEXT NOT NULL,            -- token_info / market_kline / market_trending / market_trenches / token_security
+    request_args TEXT,                 -- JSON 数组：实际传给 gmgn-cli 的参数
+    fetched_at INTEGER NOT NULL,
+    payload_sha256 TEXT NOT NULL,
+    payload_json TEXT NOT NULL
+);
+CREATE UNIQUE INDEX IF NOT EXISTS ux_raw_dedupe
+    ON raw_responses(chain, endpoint, IFNULL(token_address, ''), fetched_at, payload_sha256);
+CREATE INDEX IF NOT EXISTS ix_raw_lookup ON raw_responses(chain, endpoint, token_address, fetched_at);
+
+-- 采集失败明细。单个 token 失败只写这里，不让整批失败。
+CREATE TABLE IF NOT EXISTS collection_errors (
+    id INTEGER PRIMARY KEY AUTOINCREMENT,
+    collector TEXT NOT NULL,           -- daily / daily_hook
+    chain TEXT,
+    token_address TEXT,
+    endpoint TEXT,
+    bucket_day INTEGER,                -- UTC 日 00:00
+    occurred_at INTEGER NOT NULL,
+    error_kind TEXT NOT NULL,          -- rate_limited / cooldown / timeout / cli_error / parse_error / validation / db_error / error
+    error_message TEXT,
+    request_args TEXT
+);
+CREATE INDEX IF NOT EXISTS ix_cerr_day ON collection_errors(bucket_day, chain, token_address);
 """
 
 
